# Copy this file to  .env  (same folder as manage.py) and fill in YOUR values.
# The .env file is private: it must stay in .gitignore and never be uploaded.

DEBUG=True
SECRET_KEY=put-a-long-random-text-here
DATABASE_URL=put-your-neon-address-here
CLOUDINARY_CLOUD_NAME=put-your-cloud-name-here
CLOUDINARY_API_KEY=put-your-api-key-here
CLOUDINARY_API_SECRET=put-your-new-api-secret-here
